# Credenciais da API Táxi Digital (Basic Auth no servidor)
TD_USER=
TD_PASS=
# Opcional: usado apenas se o Checkpoint C confirmar necessidade de X-uiCliente
TD_CLIENT_IDS=

# Segredo de validação do Webhook da Táxi Digital (header X-Webhook-Secret)
WEBHOOK_SECRET=
# URL alvo para o script npm run test:webhook (produção na Vercel ou http://localhost:3000/api/taxidigital/webhook)
WEBHOOK_URL=https://medicao-petro.vercel.app/api/taxidigital/webhook

# Controle de Acesso do App e Sessão Assinada (HMAC-SHA256)
APP_ACCESS_PASSWORD=
SESSION_SECRET=

# Banco de Dados Serverless (Neon Postgres)
DATABASE_URL=

# Retenção LGPD do payload bruto de webhook_events (em dias, padrão 180) e segredo do Vercel Cron
WEBHOOK_RETENTION_DAYS=180
CRON_SECRET=

# Inteligência Artificial (Google Gemini no backend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
